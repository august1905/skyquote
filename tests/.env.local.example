# Copy to tests/.env.local (gitignored) and fill in the real values.
#
# These are working logins against the Skyquote Catalyst Data Store —
# TEST_ADMIN is a real admin account — which is why they are not committed.

TEST_ADMIN_PASSWORD=
TEST_SHARED_USER_PASSWORD=

# Optional — only if you seeded the accounts under different addresses.
# TEST_ADMIN_EMAIL=playwright-admin@example.com
# TEST_SHARED_USER_EMAIL=playwright-shared-user@example.com
